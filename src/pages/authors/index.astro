---
import AuthorCard from '@/components/AuthorCard.astro'
import Container from '@/components/Container.astro'
import PageBand from '@/components/PageBand.astro'
import Layout from '@/layouts/Layout.astro'
import { getCollection } from 'astro:content'

const authors = await getCollection('authors')
---

<Layout title="Authors" description="A list of authors on this site.">
  <PageBand
    title="Authors"
    crumbs={[{ label: 'Blog', href: '/blog' }, { label: 'Authors' }]}
  />
  <Container class="pt-8 sm:pt-10">
    {
      authors.length > 0 ? (
        <ul class="not-prose flex flex-col gap-4">
          {authors.map((author) => (
            <li>
              <AuthorCard author={author} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-muted-foreground">No authors found.</p>
      )
    }
  </Container>
</Layout>
