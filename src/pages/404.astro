---
import Container from '@/components/Container.astro'
import PageBand from '@/components/PageBand.astro'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { Icon } from 'astro-icon/components'
---

<Layout title="Page not found" description={SITE.DESCRIPTION}>
  <PageBand
    title="Page not found"
    crumbs={[{ label: '404' }]}
    description="This record doesn't exist. The link may be old, or the page may have moved."
  />
  <Container class="pt-8 sm:pt-10">
    <a href="/" class="btn btn-outline group">
      <Icon
        name="lucide:arrow-left"
        class="size-4 transition-transform duration-200 group-hover:-translate-x-0.5"
      />
      Back to overview
    </a>
  </Container>
</Layout>
