---
import Container from '@/components/Container.astro'
import Link from '@/components/Link.astro'
import PageBand from '@/components/PageBand.astro'
import { badgeVariants } from '@/components/ui/badge'
import Layout from '@/layouts/Layout.astro'
import { Icon } from 'astro-icon/components'
import { getCollection } from 'astro:content'

const blog = (await getCollection('blog')).filter((post) => !post.data.draft)

const tagCounts = blog.reduce((acc, post) => {
  post.data.tags?.forEach((tag) => {
    acc.set(tag, (acc.get(tag) || 0) + 1)
  })
  return acc
}, new Map())

const tags = [...tagCounts.keys()].sort((a, b) => {
  const countDiff = tagCounts.get(b)! - tagCounts.get(a)!
  return countDiff !== 0 ? countDiff : a.localeCompare(b)
})
---

<Layout title="Tags" description="A list of all tags used in blog posts">
  <PageBand
    title="Tags"
    crumbs={[{ label: 'Blog', href: '/blog' }, { label: 'Tags' }]}
  />
  <Container class="pt-8 sm:pt-10">
    <ul class="flex flex-wrap gap-2">
      {
        tags.map((tag) => (
          <li>
            <Link
              href={`/tags/${tag}`}
              class={badgeVariants({ variant: 'secondary' }) + ' !py-1 text-sm no-underline'}
            >
              <Icon name="lucide:hash" class="size-3.5" />
              {tag}
              <span class="meta ml-1">{tagCounts.get(tag)}</span>
            </Link>
          </li>
        ))
      }
    </ul>
  </Container>
</Layout>
