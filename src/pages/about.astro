---
import Container from '@/components/Container.astro'
import PageBand from '@/components/PageBand.astro'
import WorkRow from '@/components/WorkRow.astro'
import Layout from '@/layouts/Layout.astro'
import { getWorks } from '@/lib/works'

const works = await getWorks()
---

<Layout
  title="Works"
  description="Selected work by Rohan, SWE at TechCrafter."
>
  <PageBand title="Works" crumbs={[{ label: 'Works' }]} />

  <Container class="flex flex-col gap-8 pt-8 sm:pt-10">
    <div class="flex max-w-[65ch] flex-col gap-4 text-lg leading-relaxed">
      <p>
        Below are some of the projects that helped me outskill myself a little
        more every day. Each one taught me something I did not know when I
        started it.
      </p>
    </div>

    <section class="panel overflow-hidden" aria-labelledby="all-works">
      <header
        class="flex items-baseline justify-between gap-4 border-b px-4 py-4 sm:px-5"
      >
        <h2 id="all-works" class="panel-title">All works</h2>
        <span class="meta">{works.length} {works.length === 1 ? 'project' : 'projects'}</span>
      </header>
      <ul class="divide-y">
        {
          works.map((work) => (
            <li>
              <WorkRow work={work} full />
            </li>
          ))
        }
      </ul>
    </section>
  </Container>
</Layout>
