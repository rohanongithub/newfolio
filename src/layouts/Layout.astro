---
import Footer from '@/components/Footer.astro'
import Head from '@/components/Head.astro'
import Header from '@/components/Header.astro'
import { SITE } from '@/consts'

type Props = {
  title: string
  description: string
  image?: string
  imageAlt?: string
  jsonLd?: Record<string, unknown>
}

const { title, description, image, imageAlt, jsonLd } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta
      name="google-site-verification"
      content="yQr2lvKsrMS9KjyUJkF3_RmEkCGGlKOw-DSfh1FygeI"
    />
    <Head
      title={`${title} | ${SITE.TITLE}`}
      description={description}
      image={image}
      imageAlt={imageAlt}
      jsonLd={jsonLd}
    />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground"
    >
      Skip to content
    </a>
    <div class="box-border flex min-h-screen flex-col">
      <Header />
      <main id="main" class="flex-grow">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
