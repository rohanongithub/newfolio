---
import { fetchGitHubContributions } from '../scripts/github.ts'

const data = await fetchGitHubContributions()

const WEEKS_SHOWN = 26
const levels = [
  'bg-secondary',
  'bg-primary/25',
  'bg-primary/50',
  'bg-primary/75',
  'bg-primary',
]
const levelFor = (count: number) =>
  count === 0 ? 0 : count < 3 ? 1 : count < 6 ? 2 : count < 10 ? 3 : 4

const weeks = data?.weeks.slice(-WEEKS_SHOWN) ?? []
---

{
  data && (
    <section class="panel p-4 sm:p-5" aria-labelledby="activity-title">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <h2 id="activity-title" class="panel-title">
          Activity
        </h2>
        <p class="meta">
          {data.totalContributions} contributions in the past year
        </p>
      </div>
      <div
        class="mt-4 grid grid-flow-col grid-rows-7 gap-[3px]"
        style="grid-auto-columns: minmax(0, 1fr)"
        role="img"
        aria-label={`Contribution graph for the last ${WEEKS_SHOWN} weeks, ${data.totalContributions} contributions in the past year`}
      >
        {weeks.map((week) =>
          week.contributionDays.map((day) => (
            <div
              class={`aspect-square rounded-[2px] ${levels[levelFor(day.contributionCount)]}`}
              title={`${day.date}: ${day.contributionCount} contributions`}
            />
          )),
        )}
      </div>
    </section>
  )
}
