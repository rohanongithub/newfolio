---
import Container from '@/components/Container.astro'
import { INTERVIEW_MAILTO, PROFILE } from '@/consts'
import { Icon } from 'astro-icon/components'

const stages = ['Applied', 'Screening', 'Interview', 'Offer']
const current = 1
---

<section class="bg-band text-white" aria-labelledby="candidate-name">
  <Container class="pt-10 sm:pt-14">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="flex items-start gap-4 sm:items-stretch sm:gap-6">
        <div
          class="grid size-20 flex-shrink-0 place-items-center rounded-lg bg-white font-display text-5xl font-extrabold text-band sm:h-auto sm:w-[7.25rem] sm:text-7xl"
          aria-hidden="true"
        >
          R
        </div>
        <div class="min-w-0">
          <h1
            id="candidate-name"
            class="-mt-[0.075em] font-display text-6xl font-extrabold leading-[0.9] tracking-tight sm:-mt-[0.128em] sm:text-8xl"
          >
            {PROFILE.name}
          </h1>
          <p class="-mb-[0.41em] mt-3 text-balance text-base text-band-mute sm:text-lg">
            <span class="block sm:inline">{PROFILE.role}</span>
            <span class="hidden sm:inline" aria-hidden="true">·</span>
            <span class="block sm:inline">{PROFILE.education}</span>
          </p>
        </div>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row">
        <a
          href={PROFILE.resume}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-light h-12 px-5 text-base"
        >
          <Icon name="lucide:file-text" class="size-5" />
          Resume
          <span class="sr-only">(opens in a new tab)</span>
        </a>
        <a
          id="advance"
          href={INTERVIEW_MAILTO}
          class="btn btn-advance h-12 px-5 text-base"
        >
          Advance to interview
          <Icon name="lucide:arrow-right" class="size-5" />
        </a>
      </div>
    </div>

    <p
      class="mt-6 inline-flex items-center gap-2 rounded bg-white/15 px-3 py-1.5 text-sm font-medium"
    >
      <span class="size-2 rounded-full bg-[#5EEAA8]" aria-hidden="true"></span>
      {PROFILE.status}
    </p>

    <div
      class="stage-rail mt-8 pb-8"
      data-stage-rail
      data-stage={current}
      style={`--p:${current / (stages.length - 1)}`}
    >
      <ol class="relative h-14" aria-label="Hiring pipeline stage">
        <div class="stage-track" aria-hidden="true">
          <div class="stage-fill"></div>
        </div>
        {
          stages.map((name, i) => (
            <li
              data-stage-item
              data-state={i < current ? 'done' : i === current ? 'current' : 'todo'}
              aria-current={i === current ? 'step' : undefined}
              class="stage-item"
              style={`left: calc((100% - 20px) * ${i / (stages.length - 1)})`}
            >
              <span class="stage-dot">
                <Icon name="lucide:check" class="stage-check size-3" />
              </span>
              <span
                class:list={['stage-label', i === stages.length - 1 && 'stage-label-end']}
              >
                {name}
              </span>
            </li>
          ))
        }
      </ol>
      <p class="sr-only" aria-live="polite" data-stage-live></p>
    </div>
  </Container>
</section>

<style>
  .stage-track {
    position: absolute;
    top: 9px;
    left: 10px;
    right: 10px;
    height: 2px;
    background: rgb(255 255 255 / 0.5);
  }
  .stage-fill {
    position: absolute;
    inset: 0;
    background: #fff;
    transform-origin: left center;
    transform: scaleX(var(--p, 0.3333));
    transition: transform 720ms var(--ease-out-expo);
    animation: stage-fill-in 1100ms var(--ease-out-expo) 150ms both;
  }
  @keyframes stage-fill-in {
    from {
      transform: scaleX(0);
    }
  }

  .stage-dot {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 999px;
    border: 2px solid rgb(255 255 255 / 0.55);
    background: hsl(var(--band));
    color: hsl(var(--band));
    transition:
      background-color 300ms var(--ease-out-expo),
      border-color 300ms var(--ease-out-expo),
      transform 500ms var(--ease-out-expo);
  }
  .stage-check {
    opacity: 0;
    transition: opacity 200ms ease-out;
  }
  .stage-item[data-state='done'] .stage-dot {
    background: #fff;
    border-color: #fff;
  }
  .stage-item[data-state='done'] .stage-check {
    opacity: 1;
  }
  .stage-item[data-state='current'] .stage-dot {
    background: hsl(var(--stage));
    border-color: hsl(var(--stage));
    transform: scale(1.2);
    box-shadow: 0 0 0 5px rgb(255 255 255 / 0.18);
  }

  .stage-item {
    position: absolute;
    top: 0;
    width: 20px;
  }
  .stage-label {
    position: absolute;
    top: 30px;
    left: 0;
    white-space: nowrap;
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    color: hsl(var(--band-mute));
    padding: 1px 0;
    border-radius: 4px;
    transition:
      background-color 300ms var(--ease-out-expo),
      color 300ms var(--ease-out-expo),
      padding 300ms var(--ease-out-expo);
  }
  .stage-label-end {
    left: auto;
    right: 0;
  }
  .stage-item[data-state='done'] .stage-label {
    color: #fff;
  }
  .stage-item[data-state='current'] .stage-label {
    background: hsl(var(--stage));
    color: hsl(var(--stage-foreground));
    font-weight: 700;
    padding: 1px 8px;
    margin-left: -2px;
  }

  /* Returning to Home in the same session: show the rail already settled. */
  :global(html[data-rail-seen]) .stage-fill {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .stage-fill {
      animation: none;
    }
  }
</style>

<script>
  const STAGES = ['Applied', 'Screening', 'Interview', 'Offer']

  function init() {
    const root = document.querySelector<HTMLElement>('[data-stage-rail]')
    const advance = document.getElementById('advance') as HTMLAnchorElement | null
    const live = root?.querySelector<HTMLElement>('[data-stage-live]')
    if (!root || !advance) return

    const items = Array.from(
      root.querySelectorAll<HTMLElement>('[data-stage-item]'),
    )
    let busy = false

    const setStage = (index: number) => {
      root.dataset.stage = String(index)
      root.style.setProperty('--p', String(index / (items.length - 1)))
      items.forEach((el, i) => {
        el.dataset.state = i < index ? 'done' : i === index ? 'current' : 'todo'
        if (i === index) el.setAttribute('aria-current', 'step')
        else el.removeAttribute('aria-current')
      })
      if (live) live.textContent = `Stage: ${STAGES[index]}`
    }

    advance.addEventListener('click', (event) => {
      if (busy) return
      event.preventDefault()
      busy = true
      setStage(2)

      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches
      const open = () => {
        window.location.href = advance.href
      }
      if (reduceMotion) open()
      else window.setTimeout(open, 900)

      // The email may never be sent; don't leave the record in a stage it hasn't reached.
      const reset = () => {
        setStage(1)
        busy = false
      }
      window.addEventListener('focus', reset, { once: true })
      window.setTimeout(reset, 7000)
    })
  }

  // The intro plays once per page lifetime. On later client-side arrivals at Home the new
  // document is marked before it is painted, so the rail does not replay.
  const w = window as unknown as { __railPlayed?: boolean }
  document.addEventListener('astro:before-swap', (event) => {
    if (w.__railPlayed) {
      event.newDocument.documentElement.setAttribute('data-rail-seen', '')
    }
  })
  document.addEventListener('astro:page-load', () => {
    w.__railPlayed = true
    init()
  })
</script>
