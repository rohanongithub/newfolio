---
import Container from '@/components/Container.astro'
import { INTERVIEW_MAILTO, PROFILE } from '@/consts'
import { Icon } from 'astro-icon/components'

const stages = ['Applied', 'Screening', 'Interview', 'Offer']
const current = 1
---

<section class="bg-band text-white" aria-labelledby="candidate-name">
  <Container class="pt-10 sm:pt-14">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="flex items-start gap-4 sm:items-stretch sm:gap-6">
        <div
          data-crab-perch="hop"
          class="grid size-20 flex-shrink-0 place-items-center rounded-lg bg-white font-display text-5xl font-extrabold text-band sm:h-auto sm:w-[7.25rem] sm:text-7xl"
          aria-hidden="true"
        >
          R
        </div>
        <div class="min-w-0">
          <h1
            id="candidate-name"
            data-crab-perch="hop"
            data-crab-text
            class="-mt-[0.075em] font-display text-6xl font-extrabold leading-[0.9] tracking-tight sm:-mt-[0.128em] sm:text-8xl"
          >
            {PROFILE.name}
          </h1>
          <p class="-mb-[0.41em] mt-3 text-balance text-base text-band-mute sm:text-lg">
            <span class="sm:hidden">{PROFILE.role}, CS Major</span>
            <span class="hidden sm:inline">{PROFILE.role}</span>
            <span class="hidden sm:inline" aria-hidden="true">·</span>
            <span class="hidden sm:inline">{PROFILE.education}</span>
          </p>
        </div>
      </div>

      <div class="flex gap-2 sm:gap-3">
        <a
          href={PROFILE.resume}
          target="_blank"
          rel="noopener noreferrer"
          data-crab-perch
          class="btn btn-light h-12 flex-1 px-3 text-sm sm:flex-none sm:px-5 sm:text-base"
        >
          <Icon name="lucide:file-text" class="size-4 sm:size-5" />
          Resume
          <span class="sr-only">(opens in a new tab)</span>
        </a>
        <a
          id="advance"
          data-crab-perch
          href={INTERVIEW_MAILTO}
          class="btn btn-advance h-12 flex-1 px-3 text-sm sm:flex-none sm:px-5 sm:text-base"
        >
          Interview me?
        </a>
      </div>
    </div>

    <div
      class="stage-rail mt-8 pb-8 sm:mt-10 sm:pb-10"
      data-stage-rail
      data-stage={current}
    >
      <ol
        class="grid grid-cols-4 gap-1.5 sm:gap-2"
        aria-label="Hiring pipeline stage"
        data-crab-perch
      >
        {
          stages.map((name, i) => (
            <li
              data-stage-item
              data-state={i < current ? 'done' : i === current ? 'current' : 'todo'}
              aria-current={i === current ? 'step' : undefined}
            >
              <span class="stage-seg" aria-hidden="true">
                <span class="stage-fill" style={`--i:${i}`}></span>
              </span>
              <span class="stage-label">{name}</span>
            </li>
          ))
        }
      </ol>
      <p class="sr-only" aria-live="polite" data-stage-live></p>
    </div>
  </Container>
</section>

<style>
  /* One thin segment per stage: done is full white, current is half-filled amber (in progress). */
  .stage-seg {
    position: relative;
    display: block;
    height: 4px;
    overflow: hidden;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.22);
  }
  .stage-fill {
    position: absolute;
    inset: 0;
    background: #fff;
    transform-origin: left center;
    transform: scaleX(0);
    transition:
      transform 600ms var(--ease-out-expo),
      background-color 300ms var(--ease-out-expo);
  }
  [data-state='done'] .stage-fill {
    transform: scaleX(1);
  }
  [data-state='current'] .stage-fill {
    transform: scaleX(0.5);
    background: hsl(var(--stage));
  }
  /* Intro: the reached segments fill in one after another. Dropped once the rail moves,
     so a stage change eases through the transition instead of replaying the intro. */
  .stage-rail:not([data-settled]) [data-state='done'] .stage-fill,
  .stage-rail:not([data-settled]) [data-state='current'] .stage-fill {
    animation: stage-fill-in 700ms var(--ease-out-expo) calc(150ms + var(--i) * 180ms)
      both;
  }
  @keyframes stage-fill-in {
    from {
      transform: scaleX(0);
    }
  }

  .stage-label {
    display: block;
    margin-top: 0.625rem;
    font-size: 0.75rem;
    line-height: 1.25rem;
    font-weight: 500;
    color: hsl(var(--band-mute));
    transition: color 300ms var(--ease-out-expo);
  }
  [data-state='done'] .stage-label {
    color: #fff;
  }
  [data-state='current'] .stage-label {
    color: hsl(var(--stage));
    font-weight: 700;
  }
  @media (min-width: 640px) {
    .stage-label {
      font-size: 0.875rem;
    }
  }

  /* Returning to Home in the same session: show the rail already settled. */
  :global(html[data-rail-seen]) .stage-fill {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .stage-fill {
      animation: none;
    }
  }
</style>

<script>
  const STAGES = ['Applied', 'Screening', 'Interview', 'Offer']

  function init() {
    const root = document.querySelector<HTMLElement>('[data-stage-rail]')
    const advance = document.getElementById('advance') as HTMLAnchorElement | null
    const live = root?.querySelector<HTMLElement>('[data-stage-live]')
    if (!root || !advance) return

    const items = Array.from(
      root.querySelectorAll<HTMLElement>('[data-stage-item]'),
    )
    let busy = false

    const setStage = (index: number) => {
      root.dataset.stage = String(index)
      root.dataset.settled = ''
      items.forEach((el, i) => {
        el.dataset.state = i < index ? 'done' : i === index ? 'current' : 'todo'
        if (i === index) el.setAttribute('aria-current', 'step')
        else el.removeAttribute('aria-current')
      })
      if (live) live.textContent = `Stage: ${STAGES[index]}`
    }

    advance.addEventListener('click', (event) => {
      if (busy) return
      event.preventDefault()
      busy = true
      setStage(2)

      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches
      const open = () => {
        window.location.href = advance.href
      }
      if (reduceMotion) open()
      else window.setTimeout(open, 900)

      // The email may never be sent; don't leave the record in a stage it hasn't reached.
      const reset = () => {
        setStage(1)
        busy = false
      }
      window.addEventListener('focus', reset, { once: true })
      window.setTimeout(reset, 7000)
    })
  }

  // The intro plays once per page lifetime. On later client-side arrivals at Home the new
  // document is marked before it is painted, so the rail does not replay.
  const w = window as unknown as { __railPlayed?: boolean }
  document.addEventListener('astro:before-swap', (event) => {
    if (w.__railPlayed) {
      event.newDocument.documentElement.setAttribute('data-rail-seen', '')
    }
  })
  document.addEventListener('astro:page-load', () => {
    w.__railPlayed = true
    init()
  })
</script>
