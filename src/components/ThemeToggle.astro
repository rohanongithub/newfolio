---
import { Icon } from 'astro-icon/components'
---

<button
  type="button"
  data-theme-toggle
  class="btn btn-outline inline-flex size-9 flex-shrink-0 !px-0 sm:size-10"
  aria-label="Switch to dark theme"
  aria-pressed="false"
  title="Toggle theme"
>
  <Icon name="lucide:moon" class="size-4 dark:hidden" />
  <Icon name="lucide:sun" class="hidden size-4 dark:block" />
</button>

<script>
  // The theme change spreads from the button as a growing circle (View Transitions API).
  // Browsers without it, and visitors who prefer reduced motion, get an instant switch.
  let running: ViewTransition | null = null

  function initThemeToggle() {
    const button = document.querySelector<HTMLButtonElement>(
      '[data-theme-toggle]',
    )
    if (!button) return
    const root = document.documentElement

    const sync = () => {
      const dark = root.classList.contains('dark')
      button.setAttribute('aria-pressed', String(dark))
      button.setAttribute(
        'aria-label',
        dark ? 'Switch to light theme' : 'Switch to dark theme',
      )
    }
    sync()

    const applyTheme = (dark: boolean) => {
      root.classList.toggle('dark', dark)
      ;(window as { syncThemeColor?: (doc: Document, dark: boolean) => void }).syncThemeColor?.(
        document,
        dark,
      )
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light')
      } catch {
        // Private mode or blocked storage: the choice just won't persist.
      }
      sync()
      // Small icon swap; removed again once it has played.
      button.setAttribute('data-swapped', '')
      window.setTimeout(() => button.removeAttribute('data-swapped'), 400)
    }

    const switchInstantly = (dark: boolean) => {
      // Suppress per-element transitions for one frame so the whole page flips together.
      root.classList.add('disable-transitions')
      applyTheme(dark)
      window.requestAnimationFrame(() =>
        window.requestAnimationFrame(() =>
          root.classList.remove('disable-transitions'),
        ),
      )
    }

    button.addEventListener('click', async () => {
      const dark = !root.classList.contains('dark')
      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches

      if (reduceMotion || typeof document.startViewTransition !== 'function') {
        switchInstantly(dark)
        return
      }

      // A second click while one is running: finish that one immediately.
      running?.skipTransition()

      const rect = button.getBoundingClientRect()
      const x = rect.left + rect.width / 2
      const y = rect.top + rect.height / 2
      const radius = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y),
      )

      // Timing comes from the shared motion tokens in global.css.
      const styles = getComputedStyle(root)
      // The minifier may rewrite 650ms as .65s, so read the unit instead of assuming milliseconds.
      const rawDuration = styles.getPropertyValue('--dur-reveal').trim()
      const duration =
        (rawDuration.endsWith('ms')
          ? parseFloat(rawDuration)
          : parseFloat(rawDuration) * 1000) || 650
      const easing =
        styles.getPropertyValue('--ease-reveal').trim() ||
        'cubic-bezier(0.4, 0, 0.2, 1)'

      root.style.setProperty('--reveal-x', `${x}px`)
      root.style.setProperty('--reveal-y', `${y}px`)
      root.classList.add('theme-reveal')

      const transition = document.startViewTransition(() => {
        root.classList.add('disable-transitions')
        applyTheme(dark)
      })
      running = transition

      try {
        await transition.ready
        root.animate(
          {
            clipPath: [
              `circle(0px at ${x}px ${y}px)`,
              `circle(${radius}px at ${x}px ${y}px)`,
            ],
          },
          {
            duration,
            easing,
            // Hold the final circle until the transition ends (the base style clips to zero).
            fill: 'forwards',
            pseudoElement: '::view-transition-new(root)',
          },
        )
        await transition.finished
      } catch {
        // Skipped or interrupted: the theme is already applied, nothing more to do.
      }

      // Only the latest transition cleans up, so a skipped one cannot cut a newer one short.
      if (running === transition) {
        running = null
        root.classList.remove('theme-reveal', 'disable-transitions')
        root.style.removeProperty('--reveal-x')
        root.style.removeProperty('--reveal-y')
      }
    })
  }

  document.addEventListener('astro:page-load', initThemeToggle)
</script>
