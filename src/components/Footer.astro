---
import Container from '@/components/Container.astro'
import { PROFILE, SOCIAL_LINKS } from '@/consts'
import SocialIcons from './SocialIcons.astro'
---

<footer class="mt-16 border-t bg-card pb-[env(safe-area-inset-bottom)]">
  <Container>
    <div
      class="flex flex-col gap-4 py-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="flex flex-col gap-1">
        <p class="text-sm font-semibold">
          {PROFILE.name}
          <span class="font-normal text-muted-foreground">
            · {PROFILE.role} · {PROFILE.location}
          </span>
        </p>
        <p class="meta">
          &copy; <time>{new Date().getFullYear()}</time>
        </p>
      </div>
      <SocialIcons links={SOCIAL_LINKS} />
    </div>
  </Container>
</footer>
