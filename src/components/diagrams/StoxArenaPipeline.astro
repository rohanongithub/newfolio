---
// StoxArena decision pipeline: candles, indicators, model, one of three actions, execution.
// Same drawing conventions as AuthScaleArchitecture: inline SVG on a 300-unit canvas, theme tokens only,
// draws itself once on scroll-in, static without JS or with reduced motion.
---

<figure class="not-prose my-8" data-diagram>
  <svg
    viewBox="0 0 300 384"
    class="block h-auto w-full max-w-[380px]"
    role="img"
    aria-labelledby="sa-diagram-title sa-diagram-desc"
  >
    <title id="sa-diagram-title">StoxArena decision pipeline</title>
    <desc id="sa-diagram-desc">
      The Lighter-SDK provides candlestick data. Financial indicators are
      calculated from it. The indicator data is sent as a prompt to an
      open-source model such as Qwen or DeepSeek, which answers hold, long or
      short. A long or short decision is executed through the Lighter APIs.
    </desc>

    <!-- Candles to indicators -->
    <g class="sa-fade" style="--d:0ms;--t:200ms">
      <rect class="sa-node" x="60" y="8" width="180" height="48" rx="8"></rect>
      <text class="sa-title" x="150" y="29" text-anchor="middle">Lighter-SDK</text>
      <text class="sa-sub" x="150" y="45" text-anchor="middle">candlestick data</text>
    </g>

    <path class="sa-flow sa-draw" pathLength="1" d="M150 56 V79" style="--d:150ms;--t:150ms"></path>
    <path class="sa-tip sa-fade" d="M144.75 69.5 H155.25 L150 80 Z" style="--d:280ms;--t:100ms"></path>

    <g class="sa-fade" style="--d:250ms;--t:180ms">
      <rect class="sa-node" x="60" y="80" width="180" height="48" rx="8"></rect>
      <text class="sa-title" x="150" y="101" text-anchor="middle">Indicators</text>
      <text class="sa-sub" x="150" y="117" text-anchor="middle">smooth the curve</text>
    </g>

    <!-- Indicators to model -->
    <path class="sa-flow sa-draw" pathLength="1" d="M150 128 V151" style="--d:400ms;--t:150ms"></path>
    <path class="sa-tip sa-fade" d="M144.75 141.5 H155.25 L150 152 Z" style="--d:530ms;--t:100ms"></path>

    <g class="sa-fade" style="--d:500ms;--t:180ms">
      <rect class="sa-key" x="60" y="152" width="180" height="64" rx="8"></rect>
      <text class="sa-key-title" x="150" y="178" text-anchor="middle">Qwen, DeepSeek</text>
      <text class="sa-key-sub" x="150" y="196" text-anchor="middle">prompt in, decision out</text>
    </g>

    <!-- Model to the three decisions -->
    <path class="sa-flow sa-draw" pathLength="1" d="M150 216 V234" style="--d:680ms;--t:80ms"></path>
    <path class="sa-flow sa-draw" pathLength="1" d="M150 234 H58" style="--d:730ms;--t:120ms"></path>
    <path class="sa-flow sa-draw" pathLength="1" d="M150 234 H242" style="--d:730ms;--t:120ms"></path>
    <path class="sa-flow sa-draw" pathLength="1" d="M58 234 V255" style="--d:850ms;--t:100ms"></path>
    <path class="sa-flow sa-draw" pathLength="1" d="M150 234 V255" style="--d:850ms;--t:100ms"></path>
    <path class="sa-flow sa-draw" pathLength="1" d="M242 234 V255" style="--d:850ms;--t:100ms"></path>
    <path class="sa-tip sa-fade" d="M52.75 245.5 H63.25 L58 256 Z" style="--d:930ms;--t:100ms"></path>
    <path class="sa-tip sa-fade" d="M144.75 245.5 H155.25 L150 256 Z" style="--d:930ms;--t:100ms"></path>
    <path class="sa-tip sa-fade" d="M236.75 245.5 H247.25 L242 256 Z" style="--d:930ms;--t:100ms"></path>

    <g class="sa-fade" style="--d:900ms;--t:180ms">
      <rect class="sa-node" x="16" y="256" width="84" height="40" rx="8"></rect>
      <text class="sa-title" x="58" y="280" text-anchor="middle">Hold</text>
    </g>
    <g class="sa-fade" style="--d:950ms;--t:180ms">
      <rect class="sa-node" x="108" y="256" width="84" height="40" rx="8"></rect>
      <text class="sa-title" x="150" y="280" text-anchor="middle">Long</text>
    </g>
    <g class="sa-fade" style="--d:1000ms;--t:180ms">
      <rect class="sa-node" x="200" y="256" width="84" height="40" rx="8"></rect>
      <text class="sa-title" x="242" y="280" text-anchor="middle">Short</text>
    </g>

    <!-- Long and short to execution -->
    <path class="sa-flow sa-draw" pathLength="1" d="M242 296 V314 H150" style="--d:1100ms;--t:160ms"></path>
    <path class="sa-flow sa-draw" pathLength="1" d="M150 296 V331" style="--d:1100ms;--t:160ms"></path>
    <path class="sa-tip sa-fade" d="M144.75 321.5 H155.25 L150 332 Z" style="--d:1250ms;--t:100ms"></path>

    <g class="sa-fade" style="--d:1220ms;--t:180ms">
      <rect class="sa-key" x="60" y="332" width="180" height="48" rx="8"></rect>
      <text class="sa-key-title" x="150" y="353" text-anchor="middle">Lighter APIs</text>
      <text class="sa-key-sub" x="150" y="369" text-anchor="middle">executes the trade</text>
    </g>
  </svg>
  <figcaption class="mt-3 max-w-[68ch] text-xs text-muted-foreground">
    Data flows down. Hold means no order is sent, so only long and short reach
    the execution step, which acts on a real-money account.
  </figcaption>
</figure>

<style>
  .sa-node {
    fill: hsl(var(--background));
    stroke: hsl(var(--input));
    stroke-width: 1.5;
  }
  .sa-key {
    fill: hsl(var(--accent));
    stroke: hsl(var(--primary));
    stroke-width: 1.5;
  }
  .sa-title {
    font-size: 12px;
    font-weight: 600;
    fill: hsl(var(--foreground));
  }
  .sa-sub {
    font-size: 12px;
    fill: hsl(var(--muted-foreground));
  }
  .sa-key-title {
    font-size: 12px;
    font-weight: 600;
    fill: hsl(var(--accent-foreground));
  }
  .sa-key-sub {
    font-size: 12px;
    fill: hsl(var(--accent-foreground));
  }
  .sa-flow {
    fill: none;
    stroke: hsl(var(--primary));
    stroke-width: 1.5;
  }
  .sa-tip {
    fill: hsl(var(--primary));
  }

  /* Static by default. The script arms a hidden start state only when the figure is below the
     fold and motion is allowed, then plays it once when it scrolls into view. */
  [data-draw='armed'] .sa-draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  [data-draw='armed'] .sa-fade {
    opacity: 0;
  }
  [data-draw='play'] .sa-draw {
    stroke-dasharray: 1;
    animation: sa-draw var(--t) var(--ease-out-expo) var(--d) both;
  }
  [data-draw='play'] .sa-fade {
    animation: sa-fade var(--t) var(--ease-out-expo) var(--d) both;
  }
  @keyframes sa-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes sa-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

<script>
  function initDiagram() {
    const figure = document.querySelector<HTMLElement>('[data-diagram]')
    if (!figure || figure.dataset.draw) return

    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches
    if (reduceMotion || !('IntersectionObserver' in window)) return

    // Already on screen at load: leave it fully drawn instead of flashing and replaying.
    const rect = figure.getBoundingClientRect()
    if (rect.top < window.innerHeight * 0.7 && rect.bottom > 0) return

    figure.dataset.draw = 'armed'
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          figure.dataset.draw = 'play'
          observer.disconnect()
        }
      },
      { threshold: 0.25 },
    )
    observer.observe(figure)
  }

  document.addEventListener('astro:page-load', initDiagram)
</script>
