---
// AuthScale on AWS: request path, data layer and monitoring.
// Drawn inline (not as an image file) so every colour comes from the theme tokens and follows light/dark.
// Drawn on a 300-unit-wide canvas so the 12px labels stay legible on a phone.
// On scroll-in it draws itself once (see the script). Without JS, or with reduced motion, it is simply static.
---

<figure class="not-prose my-8" data-diagram>
  <svg
    viewBox="0 0 300 512"
    class="block h-auto w-full max-w-[380px]"
    role="img"
    aria-labelledby="authscale-diagram-title authscale-diagram-desc"
  >
    <title id="authscale-diagram-title">AuthScale architecture on AWS</title>
    <desc id="authscale-diagram-desc">
      Requests come in from the internet to an Application Load Balancer. It
      distributes traffic across three Node.js EC2 instances that belong to an
      Auto Scaling group. The instances read and write to Amazon RDS PostgreSQL
      for persistent data and to Amazon ElastiCache for Redis for caching and
      rate limits. All of this runs inside a VPC. Amazon CloudWatch collects
      logs and metrics.
    </desc>

    <!-- Boundaries -->
    <g class="as-fade" style="--d:0ms;--t:250ms">
      <rect class="as-boundary" x="2" y="64" width="296" height="358" rx="12"></rect>
      <text class="as-label" x="14" y="83">VPC</text>
      <rect class="as-boundary" x="8" y="176" width="284" height="134" rx="10"></rect>
      <text class="as-label" x="20" y="301">Auto Scaling Group</text>
    </g>

    <!-- Internet -->
    <g class="as-fade" style="--d:0ms;--t:200ms">
      <rect class="as-node" x="105" y="8" width="90" height="32" rx="16"></rect>
      <text class="as-title" x="150" y="28.5" text-anchor="middle">Internet</text>
    </g>

    <!-- Internet to load balancer -->
    <path class="as-flow as-draw" pathLength="1" d="M150 40 V99" style="--d:150ms;--t:170ms"></path>
    <path class="as-tip as-fade" d="M144.75 89.5 H155.25 L150 100 Z" style="--d:290ms;--t:110ms"></path>

    <g class="as-fade" style="--d:300ms;--t:180ms">
      <rect class="as-key" x="60" y="100" width="180" height="48" rx="8"></rect>
      <text class="as-key-title" x="150" y="120.5" text-anchor="middle">Application Load Balancer</text>
      <text class="as-key-sub" x="150" y="136.5" text-anchor="middle">health checks</text>
    </g>

    <!-- Load balancer to the three instances -->
    <path class="as-flow as-draw" pathLength="1" d="M150 148 V203" style="--d:450ms;--t:150ms"></path>
    <path class="as-flow as-draw" pathLength="1" d="M150 166 H58" style="--d:480ms;--t:150ms"></path>
    <path class="as-flow as-draw" pathLength="1" d="M150 166 H242" style="--d:480ms;--t:150ms"></path>
    <path class="as-flow as-draw" pathLength="1" d="M58 166 V203" style="--d:620ms;--t:110ms"></path>
    <path class="as-flow as-draw" pathLength="1" d="M242 166 V203" style="--d:620ms;--t:110ms"></path>
    <path class="as-tip as-fade" d="M144.75 193.5 H155.25 L150 204 Z" style="--d:570ms;--t:100ms"></path>
    <path class="as-tip as-fade" d="M52.75 193.5 H63.25 L58 204 Z" style="--d:710ms;--t:100ms"></path>
    <path class="as-tip as-fade" d="M236.75 193.5 H247.25 L242 204 Z" style="--d:710ms;--t:100ms"></path>

    <g class="as-fade" style="--d:600ms;--t:180ms">
      <rect class="as-key" x="108" y="204" width="84" height="72" rx="8"></rect>
      <text class="as-key-title" x="150" y="232" text-anchor="middle">EC2</text>
      <text class="as-key-sub" x="150" y="249" text-anchor="middle">Node.js</text>
    </g>
    <g class="as-fade" style="--d:690ms;--t:180ms">
      <rect class="as-key" x="16" y="204" width="84" height="72" rx="8"></rect>
      <text class="as-key-title" x="58" y="232" text-anchor="middle">EC2</text>
      <text class="as-key-sub" x="58" y="249" text-anchor="middle">Node.js</text>
    </g>
    <g class="as-fade" style="--d:690ms;--t:180ms">
      <rect class="as-key" x="200" y="204" width="84" height="72" rx="8"></rect>
      <text class="as-key-title" x="242" y="232" text-anchor="middle">EC2</text>
      <text class="as-key-sub" x="242" y="249" text-anchor="middle">Node.js</text>
    </g>

    <!-- Instances to the data stores -->
    <path class="as-flow as-draw" pathLength="1" d="M150 310 V328" style="--d:800ms;--t:60ms"></path>
    <path class="as-flow as-draw" pathLength="1" d="M150 328 H80" style="--d:840ms;--t:100ms"></path>
    <path class="as-flow as-draw" pathLength="1" d="M150 328 H220" style="--d:840ms;--t:100ms"></path>
    <path class="as-flow as-draw" pathLength="1" d="M80 328 V349" style="--d:930ms;--t:100ms"></path>
    <path class="as-flow as-draw" pathLength="1" d="M220 328 V349" style="--d:930ms;--t:100ms"></path>
    <path class="as-tip as-fade" d="M74.75 339.5 H85.25 L80 350 Z" style="--d:1010ms;--t:100ms"></path>
    <path class="as-tip as-fade" d="M214.75 339.5 H225.25 L220 350 Z" style="--d:1010ms;--t:100ms"></path>

    <g class="as-fade" style="--d:980ms;--t:180ms">
      <rect class="as-node" x="14" y="350" width="132" height="56" rx="8"></rect>
      <text class="as-title" x="80" y="374" text-anchor="middle">RDS PostgreSQL</text>
      <text class="as-sub" x="80" y="391" text-anchor="middle">persistent data</text>
    </g>
    <g class="as-fade" style="--d:1020ms;--t:180ms">
      <rect class="as-node" x="154" y="350" width="132" height="56" rx="8"></rect>
      <text class="as-title" x="220" y="374" text-anchor="middle">ElastiCache Redis</text>
      <text class="as-sub" x="220" y="391" text-anchor="middle">cache, rate limits</text>
    </g>

    <!-- Monitoring -->
    <path class="as-monitor as-fade" d="M150 451 V425" style="--d:1100ms;--t:150ms"></path>
    <path class="as-tip-muted as-fade" d="M144.75 434.5 H155.25 L150 424 Z" style="--d:1200ms;--t:100ms"></path>
    <g class="as-fade" style="--d:1140ms;--t:180ms">
      <rect class="as-node" x="60" y="452" width="180" height="52" rx="8"></rect>
      <text class="as-title" x="150" y="474" text-anchor="middle">CloudWatch</text>
      <text class="as-sub" x="150" y="491" text-anchor="middle">logs and metrics</text>
    </g>
  </svg>
  <figcaption class="mt-3 max-w-[68ch] text-xs text-muted-foreground">
    The request path is drawn in the accent colour and monitoring is dotted. The
    dashed outlines are the VPC and the Auto Scaling Group.
  </figcaption>
</figure>

<style>
  .as-boundary {
    fill: none;
    stroke: hsl(var(--input));
    stroke-width: 1.25;
    stroke-dasharray: 5 4;
  }
  .as-node {
    fill: hsl(var(--background));
    stroke: hsl(var(--input));
    stroke-width: 1.5;
  }
  .as-key {
    fill: hsl(var(--accent));
    stroke: hsl(var(--primary));
    stroke-width: 1.5;
  }
  .as-title {
    font-size: 12px;
    font-weight: 600;
    fill: hsl(var(--foreground));
  }
  .as-sub,
  .as-label {
    font-size: 12px;
    fill: hsl(var(--muted-foreground));
  }
  .as-key-title {
    font-size: 12px;
    font-weight: 600;
    fill: hsl(var(--accent-foreground));
  }
  .as-key-sub {
    font-size: 12px;
    fill: hsl(var(--accent-foreground));
  }
  .as-flow {
    fill: none;
    stroke: hsl(var(--primary));
    stroke-width: 1.5;
  }
  .as-monitor {
    fill: none;
    stroke: hsl(var(--muted-foreground));
    stroke-width: 1.5;
    stroke-dasharray: 2 4;
    stroke-linecap: round;
  }
  .as-tip {
    fill: hsl(var(--primary));
  }
  .as-tip-muted {
    fill: hsl(var(--muted-foreground));
  }

  /* Static by default. The script arms a hidden start state only when the figure is below the
     fold and motion is allowed, then plays it once when it scrolls into view. */
  [data-draw='armed'] .as-draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  [data-draw='armed'] .as-fade {
    opacity: 0;
  }
  [data-draw='play'] .as-draw {
    stroke-dasharray: 1;
    animation: as-draw var(--t) var(--ease-out-expo) var(--d) both;
  }
  [data-draw='play'] .as-fade {
    animation: as-fade var(--t) var(--ease-out-expo) var(--d) both;
  }
  @keyframes as-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes as-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

<script>
  function initDiagram() {
    const figure = document.querySelector<HTMLElement>('[data-diagram]')
    if (!figure || figure.dataset.draw) return

    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches
    if (reduceMotion || !('IntersectionObserver' in window)) return

    // Already on screen at load: leave it fully drawn instead of flashing and replaying.
    const rect = figure.getBoundingClientRect()
    if (rect.top < window.innerHeight * 0.7 && rect.bottom > 0) return

    figure.dataset.draw = 'armed'
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          figure.dataset.draw = 'play'
          observer.disconnect()
        }
      },
      { threshold: 0.25 },
    )
    observer.observe(figure)
  }

  document.addEventListener('astro:page-load', initDiagram)
</script>
