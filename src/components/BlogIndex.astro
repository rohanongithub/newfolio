---
import Container from '@/components/Container.astro'
import PageBand from '@/components/PageBand.astro'
import PostRow from '@/components/PostRow.astro'
import PaginationComponent from '@/components/ui/pagination'
import Layout from '@/layouts/Layout.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  page: {
    data: CollectionEntry<'blog'>[]
    currentPage: number
    lastPage: number
  }
}

const { page } = Astro.props

const postsByYear = page.data.reduce(
  (acc: Record<string, CollectionEntry<'blog'>[]>, post) => {
    const year = post.data.date.getFullYear().toString()
    ;(acc[year] ??= []).push(post)
    return acc
  },
  {},
)

const years = Object.keys(postsByYear).sort((a, b) => parseInt(b) - parseInt(a))

const crumbs = [
  { label: 'Blog', href: page.currentPage > 1 ? '/blog' : undefined },
  ...(page.currentPage > 1 ? [{ label: `Page ${page.currentPage}` }] : []),
]
---

<Layout title="Blog" description="Notes and write-ups by Rohan.">
  <PageBand
    title="Blog"
    crumbs={crumbs}
    description="Notes and write-ups on what I build and learn."
  />

  <Container class="flex flex-col gap-8 pt-8 sm:pt-10">
    {
      page.data.length === 0 && (
        <p class="py-6 text-center text-sm text-muted-foreground">
          Blogs will be written soon.
        </p>
      )
    }
    {
      years.map((year) => (
        <section class="panel overflow-hidden" aria-labelledby={`year-${year}`}>
          <header class="border-b px-4 py-4 sm:px-5">
            <h2 id={`year-${year}`} class="panel-title tnum">
              {year}
            </h2>
          </header>
          <ul class="divide-y">
            {postsByYear[year].map((post) => (
              <li>
                <PostRow entry={post} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    {
      page.lastPage > 1 && (
        <PaginationComponent
          currentPage={page.currentPage}
          totalPages={page.lastPage}
          baseUrl="/blog/"
          client:load
        />
      )
    }
  </Container>
</Layout>
