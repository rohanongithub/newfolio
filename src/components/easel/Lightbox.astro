---
import { Icon } from 'astro-icon/components'
---

<div class="lb" data-lightbox hidden role="dialog" aria-modal="true" aria-label="Artwork viewer">
  <div class="lb-scrim" data-lb-scrim></div>
  <div class="lb-stage" data-lb-stage>
    <img class="lb-img" data-lb-img alt="Artwork" draggable="false" />
  </div>
  <div class="lb-bar">
    <p class="lb-caption"><span data-lb-title></span> <span data-lb-meta class="lb-meta"></span></p>
    <div class="lb-actions">
      <button type="button" data-lb-close aria-label="Close viewer">
        <Icon name="lucide:x" class="size-5" aria-hidden="true" />
      </button>
    </div>
  </div>
  <button type="button" class="lb-side lb-side-prev" data-lb-prev aria-label="Previous piece">
    <Icon name="lucide:chevron-left" class="size-6" aria-hidden="true" />
  </button>
  <button type="button" class="lb-side lb-side-next" data-lb-next aria-label="Next piece">
    <Icon name="lucide:chevron-right" class="size-6" aria-hidden="true" />
  </button>
  <p class="lb-hint">
    <span class="lb-hint-desk">Double-click or scroll to zoom. Arrows to browse. Esc to close.</span>
    <span class="lb-hint-touch">Double-tap or pinch to zoom. Swipe to browse.</span>
  </p>
</div>

<style>
  .lb {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    color: hsl(var(--room-ink));
    touch-action: none;
  }
  .lb[hidden] {
    display: none;
  }
  .lb-scrim {
    position: absolute;
    inset: 0;
    background: hsl(var(--room) / 0.96);
    opacity: 0;
  }
  .lb-stage {
    position: relative;
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: center;
    padding: 4.5rem 1rem 3.5rem;
    overflow: hidden;
  }
  .lb-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    user-select: none;
    cursor: zoom-in;
    transform-origin: 50% 50%;
    border-radius: 4px;
  }
  .lb-bar {
    position: absolute;
    inset: 0 0 auto 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem max(1rem, 3vw);
    font-size: 0.875rem;
  }
  .lb-caption {
    margin: 0;
    font-weight: 600;
  }
  .lb-meta {
    margin-left: 0.5rem;
    font-weight: 400;
    color: hsl(var(--room-mute));
  }
  .lb-actions {
    display: flex;
    gap: 0.25rem;
  }
  .lb-actions button,
  .lb-side {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid hsl(var(--room-line));
    border-radius: 0.5rem;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: background-color var(--dur-base) var(--ease-out-expo);
  }
  .lb-actions button:focus-visible,
  .lb-side:focus-visible {
    outline: 2px solid hsl(var(--room-ink));
    outline-offset: 2px;
  }
  @media (hover: hover) {
    .lb-actions button:hover,
    .lb-side:hover {
      background: hsl(var(--room-line));
    }
  }
  @media (min-width: 768px) {
    .lb-stage {
      padding-inline: 5rem;
    }
  }
  .lb-side {
    position: absolute;
    top: 50%;
    z-index: 2;
    translate: 0 -50%;
    background: hsl(var(--room) / 0.7);
  }
  .lb-side-prev {
    left: max(0.75rem, 2vw);
  }
  .lb-side-next {
    right: max(0.75rem, 2vw);
  }
  .lb-hint-touch {
    display: none;
  }
  @media (max-width: 767px) {
    .lb-side,
    .lb-hint-desk {
      display: none;
    }
    .lb-hint-touch {
      display: inline;
    }
  }
  .lb-hint {
    position: absolute;
    inset: auto 0 0.875rem 0;
    margin: 0;
    text-align: center;
    font-size: 0.75rem;
    color: hsl(var(--room-mute));
  }
</style>
