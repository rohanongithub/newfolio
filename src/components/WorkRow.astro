---
import { cn } from '@/lib/utils'
import type { Work } from '@/lib/works'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'

interface Props {
  work: Work
  /** Works page: full description plus role and year. Home page: compact. */
  full?: boolean
}

const { work, full = false } = Astro.props
const facts = [work.role, work.year?.toString()].filter(Boolean).join(' · ')
---

<a href={`/projects/${work.id}`} class="row-link group no-underline">
  <div
    class={cn(
      'flex-shrink-0 overflow-hidden rounded-md border bg-secondary',
      full ? 'size-20 sm:size-28' : 'size-14 sm:size-16',
    )}
  >
    {
      work.image ? (
        <Image
          src={work.image}
          alt=""
          width={224}
          height={224}
          class="size-full object-cover"
        />
      ) : (
        <div
          class="grid size-full place-items-center bg-band font-display text-2xl font-bold text-white sm:text-4xl"
          aria-hidden="true"
        >
          {work.name.slice(0, 2).toUpperCase()}
        </div>
      )
    }
  </div>
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
      <h3
        class="font-display text-lg font-semibold tracking-tight transition-colors group-hover:text-primary"
      >
        {work.name}
      </h3>
      <Icon
        name="lucide:arrow-right"
        class="size-4 text-muted-foreground transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-primary"
      />
      {work.status && <span class="chip chip-cobalt ml-1">{work.status}</span>}
    </div>
    {full && facts && <p class="meta mt-1">{facts}</p>}
    <p
      class={cn(
        'mt-1 max-w-[68ch] text-sm text-muted-foreground',
        !full && 'line-clamp-3',
      )}
    >
      {work.description}
    </p>
    <ul class="mt-2 flex flex-wrap gap-1.5">
      {
        work.tags.map((tag, i) => (
          <li class={cn('chip', !full && i >= 3 && 'hidden sm:inline-flex')}>{tag}</li>
        ))
      }
      {
        !full && work.tags.length > 3 && (
          <li class="chip sm:hidden">
            +{work.tags.length - 3}
            <span class="sr-only"> more tags</span>
          </li>
        )
      }
    </ul>
  </div>
</a>
