---
import type { Work } from '@/lib/works'
import { cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'

interface Props {
  work: Work
  full?: boolean
}

const { work, full = false } = Astro.props

const url = work.external ? new URL(work.href) : undefined
const address = url
  ? `${url.host}${url.pathname}`.replace(/\.git$/, '').replace(/\/$/, '')
  : undefined
---

<a
  href={work.href}
  target={work.external ? '_blank' : undefined}
  rel={work.external ? 'noopener noreferrer' : undefined}
  class="row-link group no-underline"
>
  <div
    class={cn(
      'flex-shrink-0 overflow-hidden rounded-md border bg-secondary',
      full ? 'size-20 sm:size-28' : 'size-14 sm:size-16',
    )}
  >
    {
      work.image ? (
        <Image
          src={work.image}
          alt=""
          width={224}
          height={224}
          class="size-full object-cover"
        />
      ) : (
        <div
          class="grid size-full place-items-center bg-band font-display text-2xl font-bold text-white sm:text-4xl"
          aria-hidden="true"
        >
          {work.icon ? (
            <Icon name={work.icon} class="size-8 sm:size-12" />
          ) : (
            work.name[0]
          )}
        </div>
      )
    }
  </div>
  <div class="min-w-0 flex-1">
    <div class="flex items-center gap-2">
      <h3
        class="font-display text-lg font-semibold tracking-tight transition-colors group-hover:text-primary"
      >
        {work.name}
      </h3>
      <Icon
        name={work.external ? 'lucide:arrow-up-right' : 'lucide:arrow-right'}
        class="size-4 text-muted-foreground transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-primary"
      />
      {work.external && <span class="sr-only">(opens in a new tab)</span>}
    </div>
    <p
      class={cn(
        'mt-1 max-w-[68ch] text-sm text-muted-foreground',
        !full && 'line-clamp-3',
      )}
    >
      {work.description}
    </p>
    {
      full &&
        (address ? (
          <p class="meta mt-2">{address}</p>
        ) : (
          <p class="mt-2 text-xs text-muted-foreground">
            Read the write-up on this site
          </p>
        ))
    }
    <ul class="mt-2 flex flex-wrap gap-1.5">
      {work.tags.map((tag) => <li class="chip">{tag}</li>)}
    </ul>
  </div>
</a>
