---
import Link from '@/components/Link.astro'
import { cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'

const { prevPost, nextPost } = Astro.props
---

<nav
  aria-label="More posts"
  class="col-start-2 flex flex-col gap-4 border-t pt-6 sm:flex-row"
>
  <Link
    href={nextPost ? `/blog/${nextPost.id}` : '#'}
    class={cn(
      'btn btn-outline group h-auto w-full justify-start gap-3 py-3 no-underline sm:w-1/2',
      !nextPost && 'pointer-events-none opacity-50',
    )}
    aria-disabled={!nextPost}
    tabindex={nextPost ? undefined : -1}
  >
    <Icon
      name="lucide:arrow-left"
      class="size-4 flex-shrink-0 transition-transform duration-200 group-hover:-translate-x-1"
    />
    <span class="flex min-w-0 flex-col items-start text-left">
      <span class="meta">Newer post</span>
      <span class="w-full truncate text-sm font-semibold"
        >{nextPost?.data.title || 'You are on the latest post'}</span
      >
    </span>
  </Link>
  <Link
    href={prevPost ? `/blog/${prevPost.id}` : '#'}
    class={cn(
      'btn btn-outline group h-auto w-full justify-end gap-3 py-3 no-underline sm:w-1/2',
      !prevPost && 'pointer-events-none opacity-50',
    )}
    aria-disabled={!prevPost}
    tabindex={prevPost ? undefined : -1}
  >
    <span class="flex min-w-0 flex-col items-end text-right">
      <span class="meta">Older post</span>
      <span class="w-full truncate text-sm font-semibold"
        >{prevPost?.data.title || 'This is the first post'}</span
      >
    </span>
    <Icon
      name="lucide:arrow-right"
      class="size-4 flex-shrink-0 transition-transform duration-200 group-hover:translate-x-1"
    />
  </Link>
</nav>
